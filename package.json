{
  "name": "block-library",
  "version": "0.2.0",
  "private": false,
  "description": "Shared, versioned library of reusable React block components (Hero, Carousel, etc.), each with multiple variants, used across client sites. Layout composition happens in each client's code, not in Sanity — this library supplies the building blocks.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "exports": {
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5"
  },
  "devDependencies": {
    "storybook": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "vitest": "latest",
    "playwright": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  }
}
